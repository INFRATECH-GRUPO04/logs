# Bucket e prefixo da camada silver (o Java lê os CSVs daqui)
S3_BUCKET=
S3_SILVER_PREFIX=

# ============================================================
# AWS / S3 - credenciais OPCIONAIS
# Na EC2/Lambda com IAM Role: deixe as credenciais comentadas; o SDK usa a role.
# Fora da AWS: use UMA das duas formas abaixo.
# Nunca preencha só AWS_ACCESS_KEY_ID sem AWS_SECRET_ACCESS_KEY.
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Forma 1: credenciais diretas (SESSION_TOKEN só se vier de STS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Forma 2: perfil compartilhado (~/.aws/credentials e ~/.aws/config)
# AWS_PROFILE=
# AWS_SHARED_CREDENTIALS_FILE=
# AWS_CONFIG_FILE=

# Projeto Jira (igual ao JIRA_PROJECT do site)
JIRA_PROJECT=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
SLACK_WEBHOOK=

# MySQL na mesma network Docker
DB_HOST=
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Loop e regra de alerta
ALERTA_INTERVALO_SEGUNDOS=
ALERTA_JANELA_MINUTOS=
ALERTA_MIN_AMOSTRAS=
ALERTA_MAX_IDADE_MINUTOS=
